generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Submission {
  id           Int      @id @default(autoincrement())
  formType     String
  businessType String?
  name         String
  email        String
  phone        String?
  company      String?
  website      String?
  volume       String?
  budget       String?
  message      String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([formType])
  @@index([createdAt])
}